{
  "name": "daily-fortune",
  "private": true,
  "version": "2.0.0",
  "description": "make your own day — 사주 오행으로 보는 오늘·내일·주간·월간·연간·평생 운세와 궁합 (결정론적 계산)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-site.mjs",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "lint": "eslint src scripts tests server.js vite.config.js playwright.config.js eslint.config.js",
    "generate:leaders": "node scripts/gen-leaders.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "korean-lunar-calendar": "^0.3.6",
    "lunar-javascript": "^1.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "sharp": "^0.35.5",
    "vite": "^6.3.5"
  }
}
