# Railway → 서비스 → Variables 에 같은 이름으로 넣으세요. (로컬은 이 파일을 .env로 복사)

# 나이스페이 REST Server 승인 + Basic 인증 (시크릿 키는 서버 전용)
NICEPAY_MODE=sandbox
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
NICEPAY_APPROVAL_MODEL=server
NICEPAY_METHODS=card,naverpayCard,kakaopay
PAYMENTS_PROVIDER=nicepay
# live에서는 이 값을 true로 명시해야 결제를 연다. sandbox에서는 청구하지 않는다.
PAYMENTS_LIVE_ENABLED=false
# Fortune 앱 서비스에서 Railway DB 참조 변수를 연결한다: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# 기존 파일 저장 방식 호환용. DATABASE_URL이 있으면 DB를 우선하며 앱 볼륨은 필요 없다.
FORTUNE_ORDERS_DIR=
# 기본은 프리미엄 미리보기·구매 흐름. 0은 장애 대응 시 이전 무료 계산기로 복구하는 설정입니다.
FORTUNE_PAID_READINGS=1

# 정식 사이트 주소 (canonical·sitemap·공유 카드에 사용). 커스텀 도메인을 연결했다면 그 주소.
# 비워 두면 Railway의 RAILWAY_PUBLIC_DOMAIN을 씁니다. 지정하면 다른 호스트로 들어온 요청을 이 주소로 301 이동합니다.
SITE_URL=https://example.com

# Google Analytics 4 측정 ID (G-로 시작). 비우면 GA를 넣지 않습니다.
GA_MEASUREMENT_ID=

# Google AdSense 게시자 ID. 기본값은 기존 사이트의 ID입니다. off로 두면 광고 스크립트와 ads.txt를 끕니다.
ADSENSE_CLIENT=ca-pub-3073450406371629
# 수동 광고 단위 슬롯 ID (애드센스 → 광고 → 광고 단위 기준). 비우면 자동 광고만 씁니다.
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_BOTTOM=

# 카카오톡 공유용 JavaScript 키 (빌드 시점에 필요). 카카오 개발자 콘솔에 사이트 도메인을 등록해야 합니다.
VITE_KAKAO_JS_KEY=

# 검색엔진 소유 확인 메타 태그 (선택)
NAVER_SITE_VERIFICATION=b8891c3ebeb248742c25823689dcdb21019a7363
GOOGLE_SITE_VERIFICATION=
