# Railway → 서비스 → Variables 에 같은 이름으로 넣으세요. (로컬은 이 파일을 .env로 복사)

# 정식 사이트 주소 (canonical·sitemap·공유 카드에 사용). 커스텀 도메인을 연결했다면 그 주소.
# 비워 두면 Railway의 RAILWAY_PUBLIC_DOMAIN을 씁니다. 지정하면 다른 호스트로 들어온 요청을 이 주소로 301 이동합니다.
SITE_URL=https://example.com

# Google Analytics 4 측정 ID (G-로 시작). 비우면 GA를 넣지 않습니다.
GA_MEASUREMENT_ID=

# Google AdSense 게시자 ID. 기본값은 기존 사이트의 ID입니다. off로 두면 광고 스크립트와 ads.txt를 끕니다.
ADSENSE_CLIENT=ca-pub-3073450406371629
# 수동 광고 단위 슬롯 ID (애드센스 → 광고 → 광고 단위 기준). 비우면 자동 광고만 씁니다.
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_BOTTOM=

# 카카오톡 공유용 JavaScript 키 (빌드 시점에 필요). 카카오 개발자 콘솔에 사이트 도메인을 등록해야 합니다.
VITE_KAKAO_JS_KEY=

# 검색엔진 소유 확인 메타 태그 (선택)
NAVER_SITE_VERIFICATION=b8891c3ebeb248742c25823689dcdb21019a7363
GOOGLE_SITE_VERIFICATION=
